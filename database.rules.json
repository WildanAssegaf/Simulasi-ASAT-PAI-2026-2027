{
  "rules": {
    ".read": false,
    ".write": false,
    "pailab": {
      "ringkas": {
        ".read": "auth != null",
        ".indexOn": ["xp"],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['name','xp','upd']) && newData.child('name').isString() && newData.child('name').val().length <= 40 && newData.child('xp').isNumber() && newData.child('xp').val() >= 0"
        }
      }
    }
  }
}
